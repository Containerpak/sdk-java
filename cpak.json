{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Java SDK",
  "description": "OpenJDK compiler, runtime and development tools.",
  "version": "25.0.3",
  "image": "ghcr.io/containerpak/sdk-java@sha256:3e750edadbb55673eb7b4a3a6386a952d16868787e3d206b3f290699c1ed720e",
  "binaries": [
    "/usr/bin/java",
    "/usr/bin/javac",
    "/usr/bin/jar",
    "/usr/bin/javadoc",
    "/usr/bin/jshell"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "java",
    "slot": "sdk.java",
    "mode": "exclusive",
    "exports": {
      "path": [
        "/usr/bin"
      ],
      "environment": [
        "JAVA_HOME=/opt/jdk"
      ]
    }
  },
  "idle_time": 0,
  "override": {
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
